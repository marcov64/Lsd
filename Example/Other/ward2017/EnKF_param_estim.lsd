	
Label Root
{
	Son: Region
	Label Region
	{
		Var: init_region
		Var: E
		Var: X
		Var: x

	}

	Var: init
	Param: alpha
	Param: alpha_var
	Param: beta
	Param: beta_var
	Param: x0
	Param: x0_var

}


DATA

Object: Root C	1
Var: init 0 n + n n
Param: alpha 0 s + n n	50
Param: alpha_var 0 n + n n	25
Param: beta 0 s + n n	0.25
Param: beta_var 0 n + n n	0.0001
Param: x0 0 n + n n	200
Param: x0_var 0 n + n n	200

Object: Region C	1
Var: init_region 0 n + n n
Var: E 0 n + n n
Var: X 0 n + n n
Var: x 1 s + n p	200

SIM_NUM 100
SEED 1
MAX_STEP 10000
EQUATION fun_ward2017.cpp
MODELREPORT report_Baseline.html

DESCRIPTION

Object_Root

END_DESCRIPTION

Variable_init
Set the initial parameters
END_DESCRIPTION

Parameter_alpha
The average number of people entering the region in one period
_INIT_
All 1 instances equal to 50
END_DESCRIPTION

Parameter_alpha_var
Initial condition variance of alpha parameter
_INIT_
All 1 instances equal to 25
END_DESCRIPTION

Parameter_beta
The average share of people in the region that in average exits in one period
_INIT_
All 1 instances equal to 0.25
END_DESCRIPTION

Parameter_beta_var
Initial condition variance of beta parameter
_INIT_
All 1 instances equal to 0.0001
END_DESCRIPTION

Parameter_x0
The mean of the initial number of agents
_INIT_
All 1 instances equal to 200,
rounded to integer
END_DESCRIPTION

Parameter_x0_var
The variance of the initial number of agents
_INIT_
All 1 instances equal to 200
END_DESCRIPTION

Object_Region
A spatial region where agents enter and exit that can hold an indefinite number of agents
END_DESCRIPTION

Variable_init_region
Set the initial number of people in region
END_DESCRIPTION

Variable_E
Number of people entering region in period
END_DESCRIPTION

Variable_X
Number of people exiting region in period
END_DESCRIPTION

Variable_x
Number of people in region in period
_INIT_
All 1 instances equal to 200
END_DESCRIPTION


DOCUOBSERVE

END_DOCUOBSERVE


DOCUINITIAL

END_DOCUINITIAL


EQ_FILE
#include "lsd_head.h"

MODELBEGIN


EQUATION( "E" )
// Number of people entering region in period

RESULT( poisson( V( "alpha" ) ) )


EQUATION( "X" )
// Number of people exiting region in period

RESULT( poisson( V( "beta" ) * VL( "x", 1 ) ) )


EQUATION( "x" )
// Number of people in region in period

RESULT( CURRENT + V( "E" ) - V( "X" ) )


EQUATION( "t" )
// Time for data export

RESULT( T )


EQUATION( "init_region" )
// Set the initial number of people in region

WRITEL( "x", norm( V( "x0" ), sqrt( V( "x0_var" ) ) ), 0 );
PARAMETER;

RESULT( 1 )


EQUATION( "init" )
// Set the initial parameters

WRITE( "alpha", norm( V( "alpha"), sqrt( V( "alpha_var" ) ) ) );
WRITE( "beta", norm( V( "beta"), sqrt( V( "beta_var" ) ) ) );
PARAMETER;

RESULT( 1 )


MODELEND


CLOSEBEGIN
CLOSEEND
END_EQ_FILE
