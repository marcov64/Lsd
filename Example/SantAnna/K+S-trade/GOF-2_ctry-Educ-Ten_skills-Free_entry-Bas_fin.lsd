						</element>
						<element name="Lambda" type="parameter">
							<values>2;2</values>
							<description>
								<text><![CDATA[Credit limit as a multiple of sales or net worth for private firms
(>0)]]></text>
								<initialization><![CDATA[All 1 instances equal to 2.]]></initialization>
