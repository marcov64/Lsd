									<description>
										<text><![CDATA[Workers using vintage object

SHOOK: operating worker (Worker)]]></text>
									</description>
									<element name="___IDwV" type="parameter">
										<values>0;0</values>
										<description>
											<text><![CDATA[ID of worker using vintage]]></text>
											<initialization><![CDATA[All 1 instances equal to 0.]]></initialization>
										</description>
									</element>
								</object>
								<element name="__Avint" type="parameter">
									<values>0;0</values>
									<description>
										<text><![CDATA[Notional machine-level labor productivity of vintage]]></text>
										<initialization><![CDATA[All 1 instances equal to 0.]]></initialization>
									</description>
								</element>
								<element name="__IDvint" type="parameter">
									<values>0;0</values>
									<description>
										<text><![CDATA[ID number (TTTTSSSS format) of vintage
(TTTT=time of introduction, SSSS=supplier ID)]]></text>
										<initialization><![CDATA[All 1 instances equal to 0.]]></initialization>
									</description>
								</element>
								<element name="__TaxMvint" type="parameter">
									<values>0;0</values>
									<description>
										<text><![CDATA[Import duties paid to local government by vintage]]></text>
										<initialization><![CDATA[All 2 instances equal to 0]]></initialization>
									</description>
								</element>
								<element name="__nVint" type="parameter">
									<values>0;0</values>
									<description>
										<text><![CDATA[Number of machines in vintage]]></text>
										<initialization><![CDATA[All 1 instances equal to 0.]]></initialization>
									</description>
								</element>
