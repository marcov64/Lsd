						</element>
						<element name="f2trdChg" type="parameter">
							<values>0;0</values>
							<description>
								<text><![CDATA[Minimum market share of post-change-type firms in consumption-good sector
([0,1], 0=all firms equal)]]></text>
								<initialization><![CDATA[All 1 instances equal to 0.]]></initialization>
							</description>
						</element>
