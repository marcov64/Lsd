						<element name="e2" type="parameter">
							<values>1;1</values>
							<description>
								<text><![CDATA[Weight of t-2 demand on myopic expectations
([0,1])]]></text>
								<initialization><![CDATA[All 1 instances equal to 1.]]></initialization>
							</description>
						</element>
						<element name="e3" type="parameter">
							<values>1;1</values>
							<description>
								<text><![CDATA[Weight of t-3 demand on myopic expectations
([0,1])]]></text>
								<initialization><![CDATA[All 1 instances equal to 1.]]></initialization>
							</description>
						</element>
						<element name="e4" type="parameter">
							<values>1;1</values>
							<description>
								<text><![CDATA[Weight of t-4 demand on myopic expectations
([0,1])]]></text>
								<initialization><![CDATA[All 1 instances equal to 1.]]></initialization>
							</description>
						</element>
						<element name="e5" type="parameter">
