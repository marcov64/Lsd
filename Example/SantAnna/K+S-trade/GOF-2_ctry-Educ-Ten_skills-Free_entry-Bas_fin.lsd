						<element name="e0" type="parameter">
							<values>0.5;0.5</values>
							<description>
								<text><![CDATA[Weight of potential demand on expectations (animal spirits)
([0,1])]]></text>
								<initialization><![CDATA[All 1 instances equal to 0.5]]></initialization>
							</description>
						</element>
						<element name="e0Chg" type="parameter">
							<values>0.5;0.5</values>
							<description>
								<text><![CDATA[Weight of potential demand on expectations after regime change
([0,1])]]></text>
								<initialization><![CDATA[All 1 instances equal to 0.5]]></initialization>
							</description>
