						</element>
						<element name="rhoBonds" type="parameter">
							<values>0;0</values>
							<description>
								<text><![CDATA[Sovereign bonds risk premium
(>=0)]]></text>
								<initialization><![CDATA[All 1 instances equal to 0.]]></initialization>
							</description>
						</element>
						<element name="tauB" type="parameter">
							<values>0.08;0.08</values>
							<description>
								<text><![CDATA[Minimum bank capital adequacy rate
(]0,1[)]]></text>
								<initialization><![CDATA[All 2 instances equal to 0]]></initialization>
							</description>
						</element>
						<element name="tauBchg" type="parameter">
							<values>0.08;0.08</values>
							<description>
								<text><![CDATA[Minimum bank capital adequacy rate after regime change
(]0,1[)]]></text>
								<initialization><![CDATA[All 2 instances equal to 0]]></initialization>
							</description>
						</element>
						<element name="thetaBonds" type="parameter">
							<values>12;12</values>
							<description>
								<text><![CDATA[Average maturity periods of sovereign bonds
(>0)]]></text>
								<initialization><![CDATA[All 1 instances equal to 12.]]></initialization>
							</description>
						</element>
						<element name="banksMaps" type="function" lags="0">
							<description>
								<text><![CDATA[Updates the table of market share cumulative weights
Used by firms when choosing a bank]]></text>
							</description>
						</element>
						<element name="cScores" type="function" lags="0">
							<description>
								<text><![CDATA[Adjust pecking order of firms according to creditworthiness ranking]]></text>
							</description>
						</element>
						<element name="pickBank" type="function" lags="0">
							<description>
								<text><![CDATA[Select a bank randomly with probability proportional to the desired market shares of banks]]></text>
							</description>
						</element>
						<element name="BD" type="variable" lags="1" save="true">
							<values>0;0</values>
							<description>
								<text><![CDATA[Sovereign bond demand from financial sector]]></text>
								<initialization><![CDATA[All 1 instances equal to 0.]]></initialization>
							</description>
						</element>
						<element name="BS" type="variable" lags="1" save="true">
							<values>0;0</values>
							<description>
								<text><![CDATA[Sovereign bond supply from government]]></text>
							</description>
						</element>
						<element name="BadDeb" type="variable" lags="1" save="true">
							<values>0;0</values>
							<description>
								<text><![CDATA[Total losses from bad debt in financial sector]]></text>
								<initialization><![CDATA[All 1 instances equal to 0]]></initialization>
							</description>
						</element>
						<element name="BadDeb1" type="variable" lags="1" save="true">
							<values>0;0</values>
							<description>
								<text><![CDATA[Total bad debt (defaults) in financial sector from capital-good sector
(can be negative because of proceedings from healthy exiting firms)]]></text>
								<initialization><![CDATA[All 1 instances equal to 0]]></initialization>
