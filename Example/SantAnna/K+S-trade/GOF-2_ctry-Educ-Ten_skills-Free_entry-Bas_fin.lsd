							<values>19;19</values>
							<description>
								<text><![CDATA[Technical lifetime of machines
(>1)]]></text>
								<initialization><![CDATA[All 1 instances equal to 19.]]></initialization>
							</description>
						</element>
						<element name="f2min" type="parameter">
							<values>1e-05;1e-05</values>
							<description>
								<text><![CDATA[Minimum market share to stay in consumption-good sector
([0,1[)]]></text>
								<initialization><![CDATA[All 1 instances equal to 1e-05.]]></initialization>
							</description>
						</element>
						<element name="f2minPosChg" type="parameter">
							<values>0;0</values>
							<description>
								<text><![CDATA[Absolute minimum probability of new post-change-type firm in consumption-good sector
([0,1])]]></text>
								<initialization><![CDATA[All 1 instances equal to 0.]]></initialization>
