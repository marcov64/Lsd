						</element>
						<element name="LambdaChg" type="parameter">
							<values>2;2</values>
							<description>
								<text><![CDATA[Credit limit as a multiple of sales or net worth for private firms after regime change]]></text>
								<initialization><![CDATA[All 2 instances equal to 2]]></initialization>
