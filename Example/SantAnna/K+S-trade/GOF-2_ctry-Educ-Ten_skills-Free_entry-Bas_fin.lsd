(flow of money from households, creating equity stock)]]></text>
								<initialization><![CDATA[All 1 instances equal to 0.]]></initialization>
							</description>
						</element>
						<element name="Ged" type="variable" lags="1" save="true">
							<values>0;0</values>
							<description>
								<text><![CDATA[Public expenditure on education]]></text>
								<initialization><![CDATA[All 1 instances equal to 0]]></initialization>
							</description>
						</element>
						<element name="Gtrain" type="variable" lags="1" save="true">
							<values>0;0</values>
							<description>
								<text><![CDATA[Government expenditure on unemployed workers training]]></text>
								<initialization><![CDATA[All 1 instances equal to 0.]]></initialization>
							</description>
						</element>
						<element name="Gtrf" type="variable" lags="0" save="true">
							<description>
								<text><![CDATA[Government transfers (in money terms) to workers]]></text>
							</description>
						</element>
						<element name="In" type="variable" lags="0" save="true">
							<description>
								<text><![CDATA[Income received by workers (including bonus and unemployment benefits)]]></text>
							</description>
						</element>
						<element name="L" type="variable" lags="0" save="true">
							<description>
								<text><![CDATA[Labor aggregated demand]]></text>
							</description>
						</element>
						<element name="Ls" type="variable" lags="1" save="true">
							<values>0;0</values>
							<description>
								<text><![CDATA[Labor force size (supply)]]></text>
								<initialization><![CDATA[All 1 instances equal to 0.]]></initialization>
							</description>
						</element>
						<element name="Ltrain" type="variable" lags="0" save="true">
							<description>
								<text><![CDATA[Number of unemployed workers on government training]]></text>
