(>=0)]]></text>
								<initialization><![CDATA[All 2 instances equal to 0.1]]></initialization>
							</description>
						</element>
						<element name="kappaMax" type="parameter">
							<values>0.5;0.5</values>
							<description>
								<text><![CDATA[Maximum threshold share growth of capital in consumption-good sector
(0<=kappaMin<kappaMax)]]></text>
								<initialization><![CDATA[All 1 instances equal to 0.5.]]></initialization>
							</description>
						</element>
						<element name="kappaMin" type="parameter">
							<values>0;0</values>
							<description>
