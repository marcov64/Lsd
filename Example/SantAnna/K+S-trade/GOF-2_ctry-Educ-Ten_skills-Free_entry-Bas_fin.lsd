						</element>
						<element name="BadDeb2" type="variable" lags="1" save="true">
							<values>0;0</values>
							<description>
								<text><![CDATA[Total bad debt (defaults) in financial sector from consumption-good sector
(can be negative because of proceedings from healthy exiting firms)]]></text>
								<initialization><![CDATA[All 1 instances equal to 0]]></initialization>
							</description>
						</element>
						<element name="BondsB" type="variable" lags="1" save="true">
							<values>0;0</values>
							<description>
								<text><![CDATA[Total sovereign bonds stock hold by financial sector]]></text>
								<initialization><![CDATA[All 1 instances equal to 0.]]></initialization>
							</description>
						</element>
						<element name="BondsCB" type="variable" lags="1" save="true">
							<values>0;0</values>
							<description>
								<text><![CDATA[Total sovereign bonds stock hold by central bank]]></text>
								<initialization><![CDATA[All 1 instances equal to 0]]></initialization>
