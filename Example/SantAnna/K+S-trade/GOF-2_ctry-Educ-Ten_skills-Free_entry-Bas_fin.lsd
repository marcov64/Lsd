									<values>0;0</values>
									<description>
										<text><![CDATA[Price of machines in vintage]]></text>
										<initialization><![CDATA[All 1 instances equal to 0.]]></initialization>
									</description>
								</element>
								<element name="__tVint" type="parameter">
									<values>0;0</values>
									<description>
										<text><![CDATA[Build time of vintage]]></text>
										<initialization><![CDATA[All 1 instances equal to 0.]]></initialization>
									</description>
								</element>
								<element name="__toUseVint" type="parameter">
									<values>0;0</values>
									<description>
										<text><![CDATA[Number of machines desired to use in vintage]]></text>
