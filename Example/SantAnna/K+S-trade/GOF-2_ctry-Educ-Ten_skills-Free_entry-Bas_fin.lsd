						</element>
						<element name="rTchg" type="parameter">
							<values>0.01;0.01</values>
							<description>
								<text><![CDATA[Target prime interest rate set by central bank after regime change
(>0)]]></text>
								<initialization><![CDATA[All 1 instances equal to 0.01.]]></initialization>
