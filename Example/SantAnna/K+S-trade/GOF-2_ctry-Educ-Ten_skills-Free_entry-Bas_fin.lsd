						</element>
						<element name="Depo" type="variable" lags="1" save="true">
							<values>0;0</values>
							<description>
								<text><![CDATA[Total deposits on financial sector
Net deposits from exiting and entering firms in period not considered]]></text>
								<initialization><![CDATA[All 1 instances equal to 0.]]></initialization>
