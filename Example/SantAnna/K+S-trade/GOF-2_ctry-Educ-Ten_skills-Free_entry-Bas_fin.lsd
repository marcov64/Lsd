<?xml version="1.0" encoding="ISO-8859-1" standalone="yes"?>
<!DOCTYPE LSD [
 	<!ELEMENT LSD (configuration)>
 	<!ELEMENT configuration (settings, structure, equation_file)>
 	<!ELEMENT settings (simulation, data_assimilation?, profiling?)>
 	<!ELEMENT simulation EMPTY>
 	<!ELEMENT data_assimilation (ensemble_inflation?)>
 	<!ELEMENT ensemble_inflation EMPTY>
 	<!ELEMENT profiling EMPTY>
 	<!ELEMENT structure (object)>
 	<!ELEMENT object (description?, nodes?, object*, element*)>
 	<!ELEMENT description (#PCDATA)>
 	<!ELEMENT nodes (#PCDATA)>
 	<!ELEMENT element (description?, documentation?, sensitivity?, assimilation?)>
 	<!ELEMENT documentation EMPTY>
 	<!ELEMENT sensitivity (#PCDATA)>
 	<!ELEMENT assimilation (parameter?)>
 	<!ELEMENT parameter EMPTY>
 	<!ELEMENT equation_file (#PCDATA)>
]>
<LSD>
	<configuration version="1.0" description="LSD configuration file for model 'K+S (trade)', version 5.3.1, created in 26 February, 2024">
		<settings>
			<simulation steps="500" runs="1" seed="1" />
			<report_file>modelreport.html</report_file>
		</settings>
		<structure>
