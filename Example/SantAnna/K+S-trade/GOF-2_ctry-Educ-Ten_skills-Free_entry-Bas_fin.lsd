							<description>
								<text><![CDATA[Credit limit as a multiple of sales or net worth for government-owned firms
(>0)]]></text>
								<initialization><![CDATA[All 2 instances equal to 2]]></initialization>
							</description>
						</element>
						<element name="Lambda0" type="parameter">
							<values>1000;1000</values>
							<description>
								<text><![CDATA[Credit limit initial absolute floor
(>=0)]]></text>
								<initialization><![CDATA[All 1 instances equal to 1000.]]></initialization>
