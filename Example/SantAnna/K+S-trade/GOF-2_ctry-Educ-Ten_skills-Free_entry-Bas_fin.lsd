							</description>
						</element>
						<element name="F2max" type="parameter">
							<values>400;400</values>
							<description>
								<text><![CDATA[Maximum number of firms in consumption-good sector
(1<=F2min<=F20<=F2max)]]></text>
								<initialization><![CDATA[All 1 instances equal to 400.]]></initialization>
							</description>
						</element>
						<element name="F2min" type="parameter">
							<values>1;1</values>
							<description>
								<text><![CDATA[Minimum number of firms in consumption-good sector
(1<=F2min<=F20<=F2max)]]></text>
								<initialization><![CDATA[All 1 instances equal to 1.]]></initialization>
							</description>
						</element>
						<element name="NW20" type="parameter">
							<values>0;0</values>
							<description>
								<text><![CDATA[Average initial net worth in consumption-good sector
(>=0)]]></text>
								<initialization><![CDATA[All 1 instances equal to 0.]]></initialization>
							</description>
						</element>
						<element name="Phi1" type="parameter">
							<values>0.1;0.1</values>
							<description>
								<text><![CDATA[Lower support for entrant net worth share in consumption-good sector
(0<Phi1<Phi2<=1)]]></text>
								<initialization><![CDATA[All 1 instances equal to 0.1.]]></initialization>
							</description>
						</element>
						<element name="Phi2" type="parameter">
							<values>0.9;0.9</values>
							<description>
								<text><![CDATA[Upper support for entrant net worth share in consumption-good sector
(0<Phi1<Phi2<=1)]]></text>
								<initialization><![CDATA[All 1 instances equal to 0.9.]]></initialization>
							</description>
						</element>
						<element name="b" type="parameter">
							<values>3;3</values>
							<description>
								<text><![CDATA[Number of pay-back periods before machine scrapping for private firms
(>1)]]></text>
								<initialization><![CDATA[All 1 instances equal to 3]]></initialization>
							</description>
						</element>
						<element name="bChg" type="parameter">
							<values>3;3</values>
							<description>
								<text><![CDATA[Number of pay-back periods before machine scrapping for private firms after regime change
(>1)]]></text>
								<initialization><![CDATA[All 1 instances equal to 3]]></initialization>
							</description>
						</element>
						<element name="bG" type="parameter">
							<values>3;3</values>
							<description>
								<text><![CDATA[Number of pay-back periods before machine scrapping for government-owned firms
(>1)]]></text>
								<initialization><![CDATA[All 2 instances equal to 3]]></initialization>
							</description>
						</element>
						<element name="chi" type="parameter">
							<values>1;1</values>
							<description>
								<text><![CDATA[Replicator dynamics selectivity coefficient in consumption-good sector
(>0)]]></text>
								<initialization><![CDATA[All 1 instances equal to 1.]]></initialization>
							</description>
						</element>
						<element name="d2" type="parameter">
							<values>0;0</values>
							<description>
								<text><![CDATA[Dividend rate in consumption-good sector
([0,1])]]></text>
								<initialization><![CDATA[All 1 instances equal to 0.]]></initialization>
							</description>
