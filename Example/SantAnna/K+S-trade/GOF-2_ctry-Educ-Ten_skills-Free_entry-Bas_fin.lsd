						</object>
						<element name="B" type="parameter">
							<values>10;10</values>
							<description>
								<text><![CDATA[Number of heterogeneous banks
(>=1)]]></text>
								<initialization><![CDATA[All 1 instances equal to 10.]]></initialization>
