		Param: PixHeight
		Param: PixWidth

	}


}


DATA

Object: Root C	1

Object: World C	1
Var: Init 0 n + d n
Param: NCol 0 n + n n	600
Param: NRow 0 n + n n	600
Var: Action 0 s + d n
Param: PlotLattice 0 n + n n	1
Param: p 0 n + n n	0.65
Var: SumPoint 1 n + d n	0
Param: PixHeight 0 n + n n	600
Param: PixWidth 0 n + n n	600

Object: Job C	1
Param: IdJob 0 n + n n	0
Param: T 0 n + n n	0

Object: Lattice N	1

