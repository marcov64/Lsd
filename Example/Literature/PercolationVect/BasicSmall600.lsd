SIM_NUM 1
SEED 2
MAX_STEP 5000
EQUATION fun_per.cpp
MODELREPORT report_NewSim100_08.html

DESCRIPTION

Object_Root

END_DESCRIPTION

Object_World
'World' appears in the equation for: (Never Used).
END_DESCRIPTION

Variable_Init
Initialize the lattice:

- If PlotLattice !=0 then generate the lattice window

- Set the pointers to the neighbours of each cell

- If the cells have been assigned some product (generally this is not the case), store the sum for each product in "tempSales".

'Init' appears in the equation for: ActionDemand.
END_DESCRIPTION

Parameter_NCol
'NCol' appears in the equation for: Init.
END_DESCRIPTION

Parameter_NRow
'NRow' appears in the equation for: Init.
END_DESCRIPTION

Variable_Action
Ensure that all cells computed their own "State" variable

'ActionDemand' appears in the equation for: Users.
END_DESCRIPTION

Parameter_PlotLattice
'PlotLattice' appears in the equation for: Init, State.
END_DESCRIPTION

Parameter_p

END_DESCRIPTION

Variable_SumPoint

END_DESCRIPTION

Parameter_PixHeight

END_DESCRIPTION

Parameter_PixWidth

END_DESCRIPTION

Object_Job
'Supply' appears in the equation for: Init.
END_DESCRIPTION

Parameter_IdJob

END_DESCRIPTION

Parameter_T

END_DESCRIPTION

Object_Lattice
'Lattice' appears in the equation for: (Never Used).
END_DESCRIPTION

Object_Row
'Row' appears in the equation for: Init, ActionDemand.
END_DESCRIPTION

Parameter_IdRow
'IdRow' appears in the equation for: Init, State, CopyRow.
_INIT_
All 100 instances increasing from 1 with steps 1. The value is increased every 1 instances.
END_DESCRIPTION

Object_Col
'Col' appears in the equation for: Init, ActionDemand.
END_DESCRIPTION

Parameter_IdCol
'IdCol' appears in the equation for: Init, State.
_INIT_
All 10000 instances increasing from 1 with steps 1 re-starting for each group of Objects.
END_DESCRIPTION

Parameter_State
State can assume three different values: 0, 1 and 2.

If it is 0 it does nothing. State=0 means that the cell never used a product, nor it has been triggered to act (i.e. no neighbour uses a product.

State=1 means that the agent did not have a product, but the previous period a neighbour bought a product. Therefore, chooses a product (which one is decided by "Choose") and triggers the state of neighbours to be 1, subject to the neighbour has the "Flag" value of 0. Flag is 0 if you did never bought a product, or more than TimeReActivate steps have passed since last purchase.

State=2 means that the agent is currently using a product, and no neighbours had triggered it to make a new purchase.

'State' appears in the equation for: Init, ActionDemand, State, Choose.
_INIT_
Instances from 9901 to 10000 equal to 2. Instances from 9901 to 10000 equal to 1.
END_DESCRIPTION

Parameter_q
'q' appears in the equation for: Choose.
_INIT_
All 20000 instances set to random values drawn from a uniform in the range [0,1].
END_DESCRIPTION

Parameter_CopyRow
Copy of the IdRow placed in Cell, to improve speed.

'CopyRow' appears in the equation for: (Never Used).
END_DESCRIPTION

Object_Nei
'Nei' appears in the equation for: Init, State, Choose.
END_DESCRIPTION


DOCUOBSERVE

END_DOCUOBSERVE


DOCUINITIAL

END_DOCUINITIAL


EQ_FILE
#include "fun_head.h"

int **dat;
int **sta;
int NCol;
MODELBEGIN








EQUATION("Action")
/*
Comment
*/
v[0]=(double)t;
v[2]=V("NCol");
v[3]=V("NRow");

v[5]=V("PlotLattice");

v[4]=0;
v[10]=0;
CYCLE_SAFE(cur, "Job")
 {v[10]++;
  v[1]=VS(cur,"T");
  if(v[1]!=v[0])
   break;
  v[20]=VS(cur,"x");
  v[21]=VS(cur,"y");
  
  if(v[20]==v[2]-1) // go E
    h=0;
  else
    h=(int)v[20]+1;
  k=(int)v[21];
  if(dat[h][k]==1 && sta[h][k]==0)
   {
   v[4]++;
   sta[h][k]=1;
   cur2=ADDOBJ("Job");
   WRITES(cur2,"T",v[0]+1);
   WRITES(cur2,"x",(double)h);
   WRITES(cur2,"y",(double)k);
   if(v[5]==1)
    update_lattice((double)h+1, (double)k+1, 2);
   }  

  if(v[20]==0) // go W
    h=(int)v[2]-1;
  else
    h=(int)v[20]-1;
  k=(int)v[21];
  if(dat[h][k]==1 && sta[h][k]==0)
   {
   v[4]++;
   sta[h][k]=1;
   cur2=ADDOBJ("Job");
   WRITES(cur2,"T",v[0]+1);
   WRITES(cur2,"x",(double)h);
   WRITES(cur2,"y",(double)k);
   if(v[5]==1)
    update_lattice((double)h+1, (double)k+1, 2);
   }  

  if(v[21]==0) // go N
    k=(int)v[3]-1;
  else
    k=(int)v[21]-1;
  h=(int)v[20];
  if(dat[h][k]==1 && sta[h][k]==0)
   {
   v[4]++;
   sta[h][k]=1;
   cur2=ADDOBJ("Job");
   WRITES(cur2,"T",v[0]+1);
   WRITES(cur2,"x",(double)h);
   WRITES(cur2,"y",(double)k);
   if(v[5]==1)
    update_lattice((double)h+1, (double)k+1, 2);
   }  

  if(v[21]==v[3]-1) // go S
    k=0;
  else
    k=(int)v[21]+1;
  h=(int)v[20];
  if(dat[h][k]==1 && sta[h][k]==0)
   {
   v[4]++;
   sta[h][k]=1;
   cur2=ADDOBJ("Job");
   WRITES(cur2,"T",v[0]+1);
   WRITES(cur2,"x",(double)h);
   WRITES(cur2,"y",(double)k);
   if(v[5]==1)
    update_lattice((double)h+1, (double)k+1, 2);
   }  

  if(go_brother(cur)!=NULL) 
   {
    DELETE(cur);
    v[10]--;
   }
 }
if(v[4]==0)
 {
  
  quit=2;
 } 
RESULT(v[4] )

EQUATION("SumPoint")
/*
Comment
*/

RESULT( CURRENT+V("Action"))


EQUATION("Init")
/*
Initialize the lattice:

- If PlotLattice !=0 then generate the lattice window

- Set the pointers to the neighbours of each cell

*/

v[10]=V("PlotLattice");
v[8]=V("p");
NCol=v[2]=V("NCol");
v[3]=V("NRow");
v[4]=V("PixWidth");
v[5]=V("PixHeight");
if(v[10]==1)
 init_lattice(v[4],v[5], v[3], v[2], "IdRow", "IdCol", "State", NULL, 0);

dat=new int *[(int)v[3]];
sta=new int *[(int)v[3]];

for(i=0; i<(int)v[3]; i++)
 {
  dat[i]=new int [(int)v[2]];
  sta[i]=new int [(int)v[2]];
  j=(int)v[2];
  for(h=0; h<j; h++)
   {sta[i][h]=0;
    if(RND<v[8])
     dat[i][h]=1;
    else
     dat[i][h]=0; 
   }
 }  
v[11]=rnd_integer(0,v[2]-1);
v[12]=rnd_integer(0,v[3]-1);

cur=SEARCH("Job");
WRITES(cur,"T",1);
sta[(int)v[11]][(int)v[12]]=1;

WRITES(cur,"x",v[11]);
WRITES(cur,"y",v[12]);
if(v[10]==1)
 update_lattice(v[11], v[12], 2);

PARAMETER;

RESULT( 1)



MODELEND


void close_sim()
{
double v[10];
v[1]=NCol;
for(v[2]=0; v[2]<v[1]; v[2]++)
 {
  delete sta[(int)v[2]];
  delete dat[(int)v[2]];
 }
 delete sta;
 delete dat;
}
END_EQ_FILE
