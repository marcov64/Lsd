	
Label Root
{
	Son: World
	Label World
	{
		Son: Job
		Label Job
		{
			Param: IdJob
			Param: T

		}

		Son: Lattice
		Label Lattice
		{
			Son: Row
			Label Row
			{
				Son: Col
				Label Col
				{
					Son: Nei
					Label Nei
					{

					}

					Param: IdCol
					Param: State
					Param: q
					Param: CopyRow

				}

				Param: IdRow

			}


		}

		Var: Init
		Param: NCol
		Param: NRow
		Var: Action
		Param: PlotLattice
		Param: p
